@page "/edit-course/{courseId:int}"

@attribute [Authorize(Policy = "InstructorOnly")]
@inject UserManager<ApplicationUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor
@inject ApplicationDbContext Context
@inject NavigationManager NavigationManager

<PageTitle>Edit Course</PageTitle>

@if (Course == null)
{
    <div class="loading-message">
        <p>Loading course details...</p>
    </div>
}
else if (!courseExists)
{
    <div class="error-message">
        <p>Course not found or you don't have permission to edit it.</p>
        <a href="/manage-courses" class="action-button">
            <span>Back to Manage Courses</span>
            <i class="icon-arrow"></i>
        </a>
    </div>
}
else
{
    <div class="edit-course-container">
        <div class="edit-course-card">
            <div class="edit-course-header">
                <h3 class="edit-course-title">Edit Course</h3>
                <p class="edit-course-subtitle">Update the details of your course</p>
            </div>

            <EditForm Model="Course" OnValidSubmit="HandleEditCourse" class="edit-course-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="validation-summary" />

                <div class="form-group">
                    <label class="form-label">
                        <i class="icon-course"></i>
                        Course Name
                    </label>
                    <div class="input-wrapper">
                        <InputText @bind-Value="Course.Name" class="form-input" placeholder="Enter course name" />
                        <ValidationMessage For="() => Course.Name" class="validation-error" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">
                        <i class="icon-description"></i>
                        Course Description
                    </label>
                    <div class="input-wrapper">
                        <InputTextArea @bind-Value="Course.Description" class="form-input form-textarea" placeholder="Describe your course" />
                        <ValidationMessage For="() => Course.Description" class="validation-error" />
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="submit-button">
                        <span class="button-text">Save Changes</span>
                        <i class="icon-arrow"></i>
                    </button>
                    <a href="/manage-courses" class="cancel-button">
                        <span class="button-text">Cancel</span>
                        <i class="icon-cancel"></i>
                    </a>
                </div>
            </EditForm>
        </div>
    </div>
}

<style>
    .edit-course-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #FFF 0%, #764ba2 100%);
        padding: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .edit-course-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        padding: 40px;
        width: 100%;
        max-width: 500px;
        position: relative;
        overflow: hidden;
    }

        .edit-course-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(90deg, #667eea, #764ba2);
        }

    .edit-course-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .edit-course-title {
        font-size: 32px;
        font-weight: 700;
        color: #2d3748;
        margin: 0 0 10px 0;
        background: linear-gradient(135deg, #667eea, #764ba2);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .edit-course-subtitle {
        color: #718096;
        font-size: 16px;
        margin: 0;
    }

    .edit-course-form {
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    .form-label {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
        color: #4a5568;
        margin-bottom: 8px;
        font-size: 14px;
    }

    .input-wrapper {
        position: relative;
    }

    .form-input, .form-textarea {
        width: 100%;
        padding: 16px 20px;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        font-size: 16px;
        transition: all 0.3s ease;
        background: #f8fafc;
        color: #2d3748;
        box-sizing: border-box;
    }

    .form-textarea {
        min-height: 120px;
        resize: vertical;
    }

        .form-input:focus, .form-textarea:focus {
            outline: none;
            border-color: #667eea;
            background: white;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
            transform: translateY(-2px);
        }

        .form-input::placeholder, .form-textarea::placeholder {
            color: #a0aec0;
        }

    .validation-error {
        color: #e53e3e;
        font-size: 12px;
        margin-top: 5px;
        padding-left: 5px;
        font-weight: 500;
    }

    .validation-summary {
        background: #fed7d7;
        border: 1px solid #feb2b2;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 20px;
        color: #c53030;
    }

    .form-actions {
        display: flex;
        gap: 15px;
        justify-content: center;
        margin-top: 20px;
    }

    .submit-button, .cancel-button {
        border-radius: 12px;
        padding: 18px 30px;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        border: none;
        cursor: pointer;
    }

    .submit-button {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .cancel-button {
        background: linear-gradient(135deg, #e53e3e 0%, #c53030 100%);
        color: white;
    }

        .submit-button:hover, .cancel-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
        }

        .submit-button:active, .cancel-button:active {
            transform: translateY(0);
        }

        .submit-button::before, .cancel-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .submit-button:hover::before, .cancel-button:hover::before {
            left: 100%;
        }

    .button-text {
        position: relative;
        z-index: 1;
    }

    .loading-message, .error-message {
        text-align: center;
        padding: 40px;
        color: #718096;
        font-size: 16px;
    }

        .error-message p {
            margin-bottom: 20px;
        }

    .action-button {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 12px;
        padding: 18px 30px;
        font-size: 16px;
        font-weight: 600;
        color: white;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .action-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
        }

    .icon-course::before {
        content: '📚';
    }

    .icon-description::before {
        content: '📝';
    }

    .icon-arrow::before {
        content: '→';
    }

    .icon-cancel::before {
        content: '✖';
    }
</style>

@code {
    [Parameter]
    public int CourseId { get; set; }

    private Course Course;
    private ApplicationUser CurrentUser;
    private bool courseExists = true;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await UserManager.GetUserAsync(HttpContextAccessor.HttpContext.User);
        Course = await Context.Courses.FindAsync(CourseId);

        if (Course == null || Course.InstructorId != CurrentUser.Id)
        {
            courseExists = false;
        }
    }

    private async Task HandleEditCourse()
    {
        if (courseExists)
        {
            Context.Courses.Update(Course);
            await Context.SaveChangesAsync();
            NavigationManager.NavigateTo("/manage-courses");
        }
    }
}