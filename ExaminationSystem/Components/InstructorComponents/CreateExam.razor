    }

    .exam-actions {
        display: flex;
        gap: 10px;
    }

    .action-button {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 600;
        color: white;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        border: none;
        cursor: pointer;
    }

        .action-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
        }

        .action-button:active {
            transform: translateY(0);
        }

        .action-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .action-button:hover::before {
            left: 100%;
        }

    .edit-button {
        background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
    }

    .delete-button {
        background: linear-gradient(135deg, #e53e3e 0%, #c53030 100%);
    }

    .no-questions, .no-exams {
        text-align: center;
        color: #718096;
        font-size: 16px;
        padding: 20px;
    }

    .icon-exam::before {
        content: '📝';
    }

    .icon-course::before {
        content: '📚';
    }

    .icon-question::before {
        content: '❓';
    }

    .icon-arrow::before {
        content: '→';
    }

    .icon-edit::before {
        content: '✏️';
    }

    .icon-delete::before {
        content: '🗑️';
    }
</style>

@code {
    private ExamModel examModel = new ExamModel();
    private List<Course> Courses;
    private List<QuestionModel> Questions;
    private List<Exam> Exams;
    private ApplicationUser CurrentUser;
    private string SelectedCourseName;

    private class ExamModel
    {
        public string Name { get; set; }
        public int CourseId { get; set; }
    }

    private class QuestionModel
    {
        public int Id { get; set; }
        public string Text { get; set; }
        public bool IsSelected { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await UserManager.GetUserAsync(HttpContextAccessor.HttpContext.User);
        Courses = await Context.Courses
            .Where(c => c.InstructorId == CurrentUser.Id)
            .ToListAsync();
        if (Courses.Any())
        {
            examModel.CourseId = Courses.First().Id;
            await LoadQuestionsAndExams();
        }
    }

    private async Task LoadQuestionsAndExams()
    {
        var course = await Context.Courses.FindAsync(examModel.CourseId);
        if (course != null)
        {
            SelectedCourseName = course.Name;
            Questions = await Context.Questions
                .Where(q => q.CourseId == examModel.CourseId)
                .Select(q => new QuestionModel { Id = q.Id, Text = q.Text })
                .ToListAsync();
            Exams = await Context.Exams
                .Where(e => e.CourseId == examModel.CourseId)
                .ToListAsync();
        }
    }

    private async Task HandleCreateExam()
    {
        var exam = new Exam
        {
            Name = examModel.Name,
            CourseId = examModel.CourseId,
            ExamQuestions = Questions
                .Where(q => q.IsSelected)
                .Select(q => new ExamQuestion { QuestionId = q.Id })
                .ToList(),
        };
        await Context.Exams.AddAsync(exam);
        await Context.SaveChangesAsync();
        Snackbar.Add("Exam added successful", Severity.Success);

        examModel.Name = string.Empty; // Reset exam name
        await LoadQuestionsAndExams(); // Refresh exams list
    }

    private async Task DeleteExam(int examId)
    {
        try
        {
            var exam = await Context.Exams
                .Include(e => e.ExamQuestions)
                    .ThenInclude(eq => eq.Question)
                .FirstOrDefaultAsync(e => e.Id == examId && e.CourseId == examModel.CourseId);

            if (exam == null)
            {
                Snackbar.Add("Exam not found", Severity.Error);
                return;
            }

            bool? result = await DialogService.ShowMessageBox(
                "Confirm Delete",
                "Are you sure you want to delete this exam and all its related data?",
                yesText: "Delete",
                cancelText: "Cancel");

            if (result != true) return;

            if (exam.ExamQuestions?.Any() == true)
            {
                Context.ExamQuestions.RemoveRange(exam.ExamQuestions);
            }

            foreach (var eq in exam.ExamQuestions)
            {
                if (eq.Question != null &&
                    !await Context.ExamQuestions.AnyAsync(x => x.QuestionId == eq.QuestionId && x.ExamId != examId))
                {
                    var choices = await Context.Choices
                        .Where(c => c.QuestionId == eq.QuestionId)
                        .ToListAsync();

                    if (choices.Any())
                    {
                        Context.Choices.RemoveRange(choices);
                    }

                    Context.Questions.Remove(eq.Question);
                }
            }

            Context.Exams.Remove(exam);

            await Context.SaveChangesAsync();
            Snackbar.Add("Exam deleted successfully", Severity.Success);
            await LoadQuestionsAndExams();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting exam: {ex.Message}", Severity.Error);
        }
    }

    private void EditExam(int examId)
    {
        NavigationManager.NavigateTo($"/edit-exam/{examId}");
    }
}