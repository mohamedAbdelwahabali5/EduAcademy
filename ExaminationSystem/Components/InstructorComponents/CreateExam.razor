@page "/create-exam"

@attribute [Authorize(Policy = "InstructorOnly")]
@inject UserManager<ApplicationUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor
@inject ApplicationDbContext Context
@inject NavigationManager NavigationManager

<PageTitle>Create Exam</PageTitle>

<div class="create-exam-container">
    <div class="create-exam-card">
        <div class="create-exam-header">
            <h3 class="create-exam-title">Create & Manage Exams</h3>
            <p class="create-exam-subtitle">Create a new exam or manage existing ones</p>
        </div>

        <EditForm Model="examModel" OnValidSubmit="HandleCreateExam" class="create-exam-form">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />

            <div class="form-group">
                <label class="form-label">
                    <i class="icon-exam"></i>
                    Exam Name
                </label>
                <div class="input-wrapper">
                    <InputText @bind-Value="examModel.Name" class="form-input" placeholder="Enter exam name" />
                    <ValidationMessage For="() => examModel.Name" class="validation-error" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">
                    <i class="icon-course"></i>
                    Course
                </label>
                <div class="input-wrapper">
                     <InputSelect @bind-Value="examModel.CourseId" @onchange="LoadQuestionsAndExams" class="form-input">
                        @if (Courses != null)
                            @foreach (var course in Courses)
                            {
                                <option value="@course.Id">@course.Name</option>
                            }
                        }
                    </InputSelect>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">
                    <i class="icon-question"></i>
                    Select Questions
                </label>
                @if (Questions != null)
                {
                    @foreach (var question in Questions)
                    {
                        <div class="question-item">
                            <InputCheckbox @bind-Value="question.IsSelected" /> @question.Text
                        </div>
                    }
                }
                else
                {
                    <p class="no-questions">No questions available for this course.</p>
                }
            </div>

            <button type="submit" class="submit-button">
                <span class="button-text">Create Exam</span>
                <i class="icon-arrow"></i>
            </button>
        </EditForm>

        @if (Exams != null && Exams.Any())
        {
            <div class="exams-list">
                <h4 class="exams-title">Existing Exams for @SelectedCourseName</h4>
                @foreach (var exam in Exams)
                {
                    <div class="exam-item">
                        <div class="exam-info">
                            <h5 class="exam-name">@exam.Name</h5>
                        </div>
                        <div class="exam-actions">
                            <button class="action-button edit-button" @onclick="() => EditExam(exam.Id)">
                                <i class="icon-edit"></i> Edit
                            </button>
                            <button class="action-button delete-button" @onclick="() => DeleteExam(exam.Id)">
                                <i class="icon-delete"></i> Delete
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (examModel.CourseId != 0)
        {
            <div class="no-exams">
                <p>No exams found for this course.</p>
            </div>
        }
    </div>
</div>

<style>
    .create-exam-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #FFF 0%, #764ba2 100%);
