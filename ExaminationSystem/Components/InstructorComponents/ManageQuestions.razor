@page "/manage-questions"

@attribute [Authorize(Policy = "InstructorOnly")]
@inject UserManager<ApplicationUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor
@inject ApplicationDbContext Context
@inject NavigationManager NavigationManager

<PageTitle>Manage Questions</PageTitle>

<div class="manage-questions-container">
    <div class="manage-questions-card">
        <div class="manage-questions-header">
            <h3 class="manage-questions-title">Manage Your Questions</h3>
            <p class="manage-questions-subtitle">View, edit, or delete your questions</p>
        </div>

        @if (Questions == null || !Questions.Any())
        {
            <div class="no-questions">
                <p>No questions found. Start by adding a new question!</p>
                <a href="/add-question" class="action-button">
                    <span>Add New Question</span>
                    <i class="icon-arrow"></i>
                </a>
            </div>
        }
        else
        {
            <div class="questions-list">
                @foreach (var question in Questions)
                {
                    <div class="question-item">
                        <div class="question-info">
                            <h4 class="question-text">@question.Text</h4>
                            <p class="question-course">Course: @question.Course.Name</p>
                            <div class="choices-list">
                                <h5>Choices:</h5>
                                @foreach (var choice in question.Choices)
                                {
                                    <p class="choice-text @(choice.IsCorrect ? "correct-choice" : "")">
                                        - @choice.Text @(choice.IsCorrect ? "(Correct)" : "")
                                    </p>
                                }
                            </div>
                        </div>
                        <div class="question-actions">
                            <button class="action-button edit-button" @onclick="() => EditQuestion(question.Id)">
                                <i class="icon-edit"></i> Edit
                            </button>
                            <button class="action-button delete-button" @onclick="() => DeleteQuestion(question.Id)">
                                <i class="icon-delete"></i> Delete
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .manage-questions-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #FFF 0%, #764ba2 100%);
        padding: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .manage-questions-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        padding: 40px;
        width: 100%;
        max-width: 800px;
        position: relative;
        overflow: hidden;
    }

        .manage-questions-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(90deg, #667eea, #764ba2);
        }

    .manage-questions-header {
        text-align: center;
        margin-bottom: 40px;
    }

    .manage-questions-title {
        font-size: 32px;
        font-weight: 700;
        color: #2d3748;
        margin: 0 0 10px 0;
        background: linear-gradient(135deg, #667eea, #764ba2);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .manage-questions-subtitle {
        color: #718096;
        font-size: 16px;
        margin: 0;
    }

    .no-questions {
        text-align: center;
        padding: 20px;
    }

        .no-questions p {
            color: #718096;
            font-size: 16px;
            margin-bottom: 20px;
        }

    .questions-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .question-item {
        background: #f8fafc;
        border-radius: 12px;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
        transition: transform 0.3s ease;
    }

        .question-item:hover {
            transform: translateY(-5px);
        }

    .question-info {
        flex: 1;
    }

    .question-text {
        font-size: 20px;
        font-weight: 600;
        color: #2d3748;
        margin: 0 0 10px 0;
    }

    .question-course {
        color: #718096;
        font-size: 14px;
        margin: 0 0 5px 0;
    }

    .question-created {
        color: #a0aec0;
        font-size: 12px;
        margin: 0 0 10px 0;
    }

    .choices-list {
        margin-top: 10px;
    }

        .choices-list h5 {
            font-size: 16px;
            font-weight: 600;
            color: #4a5568;
            margin: 0 0 5px 0;
        }

    .choice-text {
        color: #718096;
        font-size: 14px;
        margin: 5px 0;
    }

    .correct-choice {
        color: #38a169;
        font-weight: 600;
    }

    .question-actions {
        display: flex;
        gap: 10px;
    }

    .action-button {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 8px;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: 600;
        color: white;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 5px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
        border: none;
        cursor: pointer;
    }

        .action-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
        }

        .action-button:active {
            transform: translateY(0);
        }

        .action-button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .action-button:hover::before {
            left: 100%;
        }

    .edit-button {
        background: linear-gradient(135deg, #48bb78 0%, #38a169 100%);
    }

    .delete-button {
        background: linear-gradient(135deg, #e53e3e 0%, #c53030 100%);
    }

    .icon-arrow::before {
        content: '→';
    }

    .icon-edit::before {
        content: '✏️';
    }

    .icon-delete::before {
        content: '🗑️';
    }
</style>

@code {
    private List<Question> Questions;
    private ApplicationUser CurrentUser;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await UserManager.GetUserAsync(HttpContextAccessor.HttpContext.User);
        Questions = await Context.Questions
            .Include(q => q.Course)
            .Include(q => q.Choices)
            .Where(q => q.Course.InstructorId == CurrentUser.Id)
            .ToListAsync();
    }

    private async Task DeleteQuestion(int questionId)
    {
        var question = await Context.Questions.FindAsync(questionId);
        if (question != null && question.Course.InstructorId == CurrentUser.Id)
        {
            Context.Questions.Remove(question);
            await Context.SaveChangesAsync();
            Snackbar.Add("Question deleted successful", Severity.Success);

            Questions = await Context.Questions
                .Include(q => q.Course)
                .Include(q => q.Choices)
                .Where(q => q.Course.InstructorId == CurrentUser.Id)
                .ToListAsync();
        }
    }

    private void EditQuestion(int questionId)
    {
        NavigationManager.NavigateTo($"/edit-question/{questionId}");
    }
}