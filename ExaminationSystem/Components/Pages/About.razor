@page "/about"

<PageTitle>About Us</PageTitle>

<div class="about-container">
    <div class="about-card">
        <div class="about-header">
            <h1 class="about-title">About EduAcademy</h1>
            <p class="about-subtitle">Empowering Education Through Seamless Exam Management</p>
        </div>

        <div class="about-section">
            <h2 class="section-title">Our Mission</h2>
            <p class="section-content">
                The EduAcademy is designed to simplify and enhance the educational experience for both instructors and students. We provide a platform where instructors can create, manage, and evaluate exams effortlessly, while students can enroll in courses, take exams, and track their progress with ease.
            </p>
        </div>

        <div class="about-section">
            <h2 class="section-title">What We Offer</h2>
            <div class="features-list">
                <div class="feature-item">
                    <h3 class="feature-title">
                        <i class="icon-instructor"></i>
                        For Instructors
                    </h3>
                    <p class="feature-description">
                        Create and manage courses, design exams, add questions, and review student performance with detailed insights.
                    </p>
                </div>
                <div class="feature-item">
                    <h3 class="feature-title">
                        <i class="icon-student"></i>
                        For Students
                    </h3>
                    <p class="feature-description">
                        Enroll in courses, take exams, view scores, and monitor your academic progress in one centralized dashboard.
                    </p>
                </div>
            </div>
        </div>

        <div class="about-section">
            <h2 class="section-title">Our Team</h2>
            <p class="section-content">
                We are a dedicated team of developers, educators, and designers working together to build a reliable and user-friendly platform for educational institutions. Our goal is to support learning and growth through technology.
            </p>
        </div>

        <div class="about-section">
            <h2 class="section-title">Contact Us</h2>
            <p class="section-content">
                Have questions or need support? Reach out to us at <a href="mailto:mohamedabdelwahabali5@gmail.com" class="contact-link">mohamedabdelwahabali5@gmail.com</a>.
            </p>
            <p class="section-content">
                Follow us on social media for updates:
                <div class="social-links">
                    <a href="https://www.facebook.com/alking.abo" target="_blank" class="social-link"><i class="icon-facebook"></i> Facebook</a>
                    <a href="https://www.linkedin.com/in/mohamed--abdelwahab/" target="_blank" class="social-link"><i class="icon-linkedin"></i> LinkedIn</a>
                </div>
            </p>
        </div>
    </div>
</div>

